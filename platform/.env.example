# Platform server configuration for local development.
# Copy to .env (git-ignored) and adjust if needed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# Matches the credentials in infra/.env
DATABASE_URL=postgres://platform:change_me_dev_only@127.0.0.1:5432/platform

# Access token signing keys. Generate with: pnpm keys:generate
JWT_SIGNING_KEYS=