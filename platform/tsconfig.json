{
  "compilerOptions": {
    // Node 24 supports modern JavaScript, no need to downlevel
    "target": "ES2024",

    // Native Node ES modules; relative imports need the .js extension
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    // Strictest useful checks
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // This config only type-checks; tsconfig.build.json emits
    "noEmit": true,

    // Faster builds, allow importing JSON
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // Type-check everything: server code, tests, scripts and config files
  "include": ["src", "test", "scripts", "*.ts"]
}