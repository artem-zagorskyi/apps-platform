{
  "name": "@apps-platform/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/core/migrate.ts",
    "keys:generate": "tsx scripts/generate-signing-key.ts",
    "db:seed": "tsx --env-file=.env scripts/seed-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "plan:upload": "tsx --env-file=.env scripts/upload-plan.ts",
    "config:schema": "tsx --env-file=.env scripts/upload-config-schema.ts",
    "config:publish": "tsx --env-file=.env scripts/publish-config.ts",
    "config:show": "tsx --env-file=.env scripts/show-config.ts",
    "keys:data": "tsx scripts/generate-data-key.ts",
    "webhooks:set": "tsx --env-file=.env scripts/set-webhook.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@opentelemetry/api": "^1.10.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "maxmind": "^5.0.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
